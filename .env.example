# DATABASE
DATABASE_URL="postgresql://user:password@localhost:5432/showforge"

# AUTHENTICATION
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-secret-here"

# AI PROVIDERS
LLM_PROVIDER="claude"
IMAGE_PROVIDER="mock"
VIDEO_PROVIDER="mock"
VOICE_PROVIDER="mock"
SOUND_PROVIDER="mock"
MUSIC_PROVIDER="mock"

# CLAUDE API
ANTHROPIC_API_KEY="sk-ant-..."

# GOOGLE APIs (for Veo video generation, image generation, etc.)
GOOGLE_API_KEY="AIza..."
GOOGLE_PROJECT_ID="..."

# OPENAI API
OPENAI_API_KEY="sk-..."

# ELEVENLABS API (for voice synthesis)
ELEVENLABS_API_KEY="..."

# S3-COMPATIBLE STORAGE
STORAGE_TYPE="local"
STORAGE_BUCKET="showforge-media"
STORAGE_REGION="us-east-1"
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_ACCESS_KEY="minioadmin"
STORAGE_SECRET_KEY="minioadmin"

# STRIPE (for payments)
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# REDIS (for job queue)
REDIS_URL="redis://localhost:6379"

# CONFIGURATION
NODE_ENV="development"
LOG_LEVEL="debug"
MAX_EPISODE_SECONDS=300
MAX_SHOTS=20
MAX_SHOT_RETRIES=3
MAX_PRODUCTION_COST=50
MAX_CONCURRENT_PRODUCTIONS=5
MAX_USER_DAILY_COST=100
GENERATION_TIMEOUT_MS=600000

# DEMO MODE (set to true to use mocks even without credentials)
DEMO_MODE="true"
