# A reachable HTTPS backend, or HTTP on your private development network.
# Set before bundling, or enter the address in the app's connection screen.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8787
# Allow local HTTP only for internal builds. Production should remain HTTPS-only.
OUTSIDE_ALLOW_LOCAL_HTTP=1
# Optional: Android Google Maps. Without it, the app uses OpenStreetMap.
# GOOGLE_MAPS_API_KEY=
